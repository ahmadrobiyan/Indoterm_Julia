Auxiliary files = term;
check-on-read all = warn;
IZ1 = no ; ! assist with pivot reuse 
File INFILE = aggmod.har;
File REGSETS = Aggsets.har;
File SUMMARY = termsum.har;
!set elements read style = flexible ;
Updated File INFILE = <cmf>.upd;
condensation information file = cond.txt ;
CVL file = <cmf>;  ! create CVL HAR file, named after CMF, to show values of all coefficients

start with MMNZ = 60000000 ;
cpu = yes ;
log file = yes ; 	
verbal description =test;
method = euler;
steps= 4;

! Automatic closure generated by TABmate Tools...Closure command
!                  Variable     Size 
Exogenous              acap ; ! IND*DST   Capital-augmenting technical change
Exogenous            alab_o ; ! IND*DST   Labor-augmenting technical change
Exogenous              alnd ; ! IND*DST   Land-augmenting technical change
Exogenous              atot ; ! IND*DST   All-input-augmenting technical change
Exogenous          bint_scd ; ! IND   Driver: intermediate tech change
Exogenous             bprim ; ! IND*DST   Driver for aprim technical change
Exogenous          bprimnat ; ! 1   Driver for aprim technical change
Exogenous           bprim_d ; ! IND   Driver for aprim technical change
Exogenous          capslack ; ! 1   Slack variable to allow fixing aggregate capital
Exogenous        delfwage_o ; ! 1   Shifter for real wage adjustment mechanism
Exogenous        delPTXRATE ; ! IND*DST   Change in rate of production tax
Exogenous          delUnity ; ! 1   Dummy variable, always exogenously set to one
Exogenous          emptrend ; ! OCC   Trend employment
Exogenous           fgovgen ; ! 1   Economy-wide govt demand shift
Exogenous           fgovtot ; ! DST   Government demand shifter
Exogenous            fgov_s ; ! COM*DST   Government demand shifter
Exogenous             finv1 ; ! IND*DST   Investment shift variable for DPSV rule
Exogenous          flabsupA ; ! OCC*DST   Labour migration shifter
Exogenous        flabsup_id ; ! OCC   National wage shifter
Exogenous           flab_id ; ! OCC   National wage shifter
Exogenous           flab_io ; ! DST   Wage shifter
Exogenous          flab_iod ; ! 1   National wage shifter
Exogenous             fpexp ; ! COM*DST   Export price shift variable
Exogenous             fqexp ; ! COM*DST   Export quantity shift variable
Exogenous            frnorm ; ! IND*DST   Shifter of Normal gross rate of return
Exogenous         frnorm_id ; ! 1   Shifter of Normal gross rate of return
Exogenous            gtrend ; ! IND*DST   Trend investment/capital ratio
Exogenous          houslack ; ! 1   Consumption slack variable to accommodate national constraint
Exogenous          invslack ; ! 1   Investment slack variable for exogenizing national investment
Exogenous          natfpexp ; ! 1   Scalar export shifter
Exogenous              nhou ; ! DST   Number of households
Exogenous             pfimp ; ! COM*ORG   Import prices, foreign currency
Exogenous               phi ; ! 1   Exchange rate, local currency/$world
Exogenous          tuser_su ; ! COM*DST   Tax shifter by commodity and region
Exogenous         tuser_sud ; ! COM   Tax shifter by commodity
Exogenous          tuser_ud ; ! COM*SRC   Tax shifter by commodity and source
Exogenous              xcap ; ! IND*DST   Capital usage
Exogenous          xhouhtot ; ! HOU*DST   Total real household consumption
Exogenous              xlnd ; ! IND*DST   Land usage
Rest endogenous; ! end of TABmate automatic closure

!  swap                   phi  =  Natmacro("GDPPI"); ! change numeraire

! swaps for shortrun closure
!       old exog    new exog
   swap invslack =  NatMacro("RealInv");
   swap xhouhtot =  fhou;    ! make regional consumption follow wage income
   swap   flab_i = flabsupA; ! switch off regional wage differentials
   swap labslack = flabsup_id; ! switch off national labour supply mechanism

! national rule for consumption
!  swap             houslack  =  shrBoTnom2;   ! alternative: fix nominal BOT/GDP
!  swap             houslack  =  natfhou;  ! fix national propensity to consume
!  swap             houslack  =  shrBoTnom;   !alternative: fic nominal BOT/GDP
 
!swap fgovtot = fgovtot2; ! make regional real gov follow regional real hou  
  
! Labour market Closure:
!Default is  choice 3A (see TAB file)
!   [national labour supply curve plus regional wage differentials]
!Typical long-run swaps might be (newly exog at left):
!   swap flabsup_id = xlab_id;   ! fix national employment (all OCCs)
!For a very shortrun closure (all real wages fixed), you could choose:
!   swap flabsupA = flab_i; ! switch off regional wage differentials

!swap  flabsup_id =labslack; ! switch off national labour supply mechanism
!swap flabsupA = flabsupC;
  
! Labour market Closure:
!Default is  choice 3A (see TAB file)
!   [national labour supply curve plus regional wage differentials]
!Typical long-run swaps might be (newly exog at left):
!   swap xlab_id = flabsup_id;   ! fix national employment (all OCCs)
!For a very shortrun closure (all real wages fixed), you could choose:
!   swap flab_i = flabsupA; ! switch off regional wage differentials
!   swap labslack = flabsup_id; ! switch off national labour supply mechanism



! Swaps and shock for investment project
!      usual exog                     new exog
swap finv1("Coal","EKalimantan")  = xinvitot("Coal","EKalimantan"); ! control investment directly
swap NatMacro("RealInv")          = invslack; ! Do NOT hold national investment fixed

shock  xinvitot("Coal","EKalimantan") = 100;
  
! end !

