RegLineWidth 0  ! Line width for region boundaries (-1[no line],0[thinnest line] ..10) [Integer]
RegLineColor 0 0 0  ! Color for region boundaries [3 integers RGB value]
LineWidth 1  ! Other Line width (0..10) [Integer]
FontSize 3  ! Font Size (4..10) [Integer]
SpaceAround 5  ! Border width (5..20) [Integer]
DesiredWidth 900  ! Width of map (500..1500) [Integer]
LowColor 180 255 255  ! Color for smallest score [3 integers RGB value]
MidColor 225 225 90  ! Color for median score [3 integers RGB value]
HighColor 255 100 100  ! Color for highest score [3 integers RGB value]
UseGreys False  ! Use grey tints for region shading [Boolean]
LowGrey 240 240 240  ! Grey for smallest score [3 integers RGB value]
MidGrey 170 170 170  ! Grey for median score [3 integers RGB value]
HighGrey 100 100 100  ! Grey for highest score [3 integers RGB value]
BackgroundColor 200 255 255  ! Color for background or sea [3 integers RGB value]
AutoScale True  ! Use automatic color scale [Boolean]
ScaleBounds 1 10  ! Min and max for color scale (if not automatic) [2 real numbers]
OrdinalShades True  ! Shade regions according to rank [Boolean]
RGBScores False  ! Treat scores as RGB integers [Boolean]
ShowLegend True  ! Show color key for scores [Boolean]
ScoreNDec 2  ! No. of decimal places for scores in color key (0..4) [Integer]
LegendPos 10 80  ! Color key position: Left,Top as % of Map size (10..90) [2 integers]
NumberRegions False  ! Show region numbers at region centres [Boolean]
ShowScores False  ! Show region scores at region centres [Boolean]
ShowNames True  ! Show region names at region centres [Boolean]
NumberRegionPatch False  ! White patch behind region labels [Boolean]
LabelSubRegionPercent 30  ! Enter number 1-99. Subpolygons with area > X% of total region will be labelled (default 30) [Integer]
Title   ! Map title: blank for no title [String]
TitlePos 50 95  ! Position of centre of Title: Left, Top as % of Map size (10..90) [2 integers]
yytrans 100  ! Stretch map vertically (80..120, 100=no stretch) [Integer]
xDistort -5  ! Positive values stretch right of map more than left (-30..+30, 0=no distortion) [Integer]
yDistort -5  ! Positive values stretch top of map more than bottom (-30..+30, 0=no distortion) [Integer]
DotCentroids False  ! Show red dots at polygon centres [Boolean]
DotCentroids1 False  ! Show blue dots at 1st polygon centres [Boolean]
DotPolyStarts False  ! Mark 1st point of each polygon with red dot [Boolean]
CopyToClipboard True  ! Copy EMF to clipboard [Boolean]
ShowPreview True  ! Pop up window with preview of map [Boolean]
